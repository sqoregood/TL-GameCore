def console_setup_menu(invalid_token=False):
    if invalid_token:
        print("\n ❌ [КРИТИЧЕСКАЯ ОШИБКА АВТОРИЗАЦИИ DISCORD]")
        print(" 🚨 Внимание! Предыдущий токен бота УСТАРЕЛ, был изменён или недействителен.")
        print(" Пожалуйста, введите НОВЫЙ актуальный токен для восстановления работы ядра.")
        print("=" * 60)
        token = input(" 👉 Введите НОВЫЙ токен вашего Discord-бота: ").strip()
        log_id = 1544103858203009124
        if os.path.exists("config.txt"):
            with open("config.txt", "r", encoding="utf-8") as f:
                lines = f.read().splitlines()
                if len(lines) >= 2:
                    try: log_id = int(lines.strip())
                    except: pass
        with open("config.txt", "w", encoding="utf-8") as f:
            f.write(f"{token}\n{log_id}")
        return token, log_id

    token = ""
    log_id = 0
    if os.path.exists("config.txt"):
        with open("config.txt", "r", encoding="utf-8") as f:
            lines = f.read().splitlines()
            if len(lines) >= 2:
                token = lines.strip()
                try: log_id = int(lines.strip())
                except: pass

    if not token:
        token = "MTU0NDM3NzU5NjA5NDA1ODYyOA.GBPi1r.-eK0XY79htYKoAsrerMjNG7fxQAjv7YRBowXPI"
    if not log_id:
        log_id = 1544103858203009124

    with open("config.txt", "w", encoding="utf-8") as f:
        f.write(f"{token}\n{log_id}")
    return token, log_id

